// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               Int               @id @default(autoincrement())
  name             String
  email            String            @unique
  password         String
  avatarUrl        String?
  targetCalories   Int?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  meals            Meal[]
  goals            Goal[]
  foodAnalysisJobs FoodAnalysisJob[]
  pdfImportJobs    PdfImportJob[]
}

model Meal {
  id        Int      @id @default(autoincrement())
  name      String
  mealType  String   @default("Uncategorized")
  quantity  Float?
  unit      String?
  calories  Float
  protein   Float?
  carbs     Float?
  fat       Float?
  imageUrl  String?
  date      DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  createdAt DateTime @default(now())
}

model Goal {
  id             Int      @id @default(autoincrement())
  targetWeight   Float?
  currentWeight  Float?
  targetCalories Int?
  targetProtein  Float?
  targetCarbs    Float?
  targetFat      Float?
  date           String? // e.g. "YYYY-MM-DD". Null means global default
  user           User     @relation(fields: [userId], references: [id])
  userId         Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, date])
}

// Tracks async AI food image analysis jobs (BullMQ)
model FoodAnalysisJob {
  id        String   @id @default(uuid())
  userId    Int
  imageId   String   @unique // BullMQ job ID
  imagePath String // Local path on disk for the worker to read
  fileHash  String // SHA-256 of file (idempotency key)
  status    String   @default("PENDING") // PENDING | PROCESSING | COMPLETED | FAILED
  result    Json? // { name, calories, protein, carbs, fat }
  errorMsg  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, fileHash]) // same user + same file = reuse existing job
}

// Tracks async PDF diary import jobs (BullMQ)
model PdfImportJob {
  id        String   @id @default(uuid())
  userId    Int
  imageId   String   @unique // BullMQ job ID (kept as imageId for naming parity)
  pdfPath   String // Saved path on disk for the worker to read
  fileHash  String // SHA-256 of PDF file (idempotency key)
  status    String   @default("PENDING") // PENDING | PROCESSING | COMPLETED | FAILED
  result    Json? // { imported, skipped, message, entries }
  errorMsg  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, fileHash]) // same user + same PDF = reuse existing job
}
